<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.n0thing.controllers.LoginController"
            prefHeight="600.0" prefWidth="900.0"
            styleClass="root">

    <!-- Panel izquierdo - Branding -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="400.0"
          styleClass="left-panel" AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

        <Label text="INVENTORY" styleClass="brand-title">
            <font>
                <Font name="System Bold" size="32.0"/>
            </font>
        </Label>

        <Label text="PRO" styleClass="brand-subtitle">
            <font>
                <Font name="System Bold" size="32.0"/>
            </font>
        </Label>

        <Label text="SN: 2024.11.001" styleClass="serial-number">
            <font>
                <Font name="Monospaced" size="11.0"/>
            </font>
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Label>

        <Label text="Sistema de gestión de inventario" styleClass="brand-description">
            <VBox.margin>
                <Insets top="40.0"/>
            </VBox.margin>
        </Label>
    </VBox>

    <!-- Panel derecho - Formulario -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="500.0"
          spacing="20.0" styleClass="right-panel"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <padding>
            <Insets top="80.0" right="60.0" bottom="80.0" left="60.0"/>
        </padding>

        <!-- Botón cerrar -->
        <Button fx:id="closeButton" text="✕" styleClass="close-button"
                onAction="#handleClose" AnchorPane.topAnchor="10.0"
                AnchorPane.rightAnchor="10.0"/>

        <!-- Selector Login/Register -->
        <HBox spacing="10.0" alignment="CENTER">
            <Button fx:id="loginTabButton" text="Iniciar Sesión"
                    styleClass="tab-button, tab-button-active"
                    onAction="#showLoginForm" prefWidth="170.0"/>
            <Button fx:id="registerTabButton" text="Registrarse"
                    styleClass="tab-button"
                    onAction="#showRegisterForm" prefWidth="170.0"/>
        </HBox>

        <!-- Formulario de Login -->
        <VBox fx:id="loginForm" spacing="16.0" visible="true" managed="true">

            <Label text="Bienvenido de nuevo" styleClass="form-title">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <VBox spacing="8.0">
                <Label text="Correo electrónico" styleClass="input-label"/>
                <TextField fx:id="loginEmailField" promptText="ejemplo@correo.com"
                           styleClass="custom-text-field"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Contraseña" styleClass="input-label"/>
                <PasswordField fx:id="loginPasswordField" promptText="••••••••"
                               styleClass="custom-text-field"/>
            </VBox>

            <Label fx:id="loginErrorLabel" styleClass="error-label"
                   visible="false" managed="false"/>

            <Button text="Iniciar Sesión" styleClass="button-primary"
                    onAction="#handleLogin" prefWidth="380.0" prefHeight="45.0">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>
            </Button>
        </VBox>

        <!-- Formulario de Registro -->
        <VBox fx:id="registerForm" spacing="16.0" visible="false" managed="false">

            <Label text="Crear cuenta nueva" styleClass="form-title">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <VBox spacing="8.0">
                <Label text="Nombre completo" styleClass="input-label"/>
                <TextField fx:id="registerNameField" promptText="Juan Pérez"
                           styleClass="custom-text-field"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Correo electrónico" styleClass="input-label"/>
                <TextField fx:id="registerEmailField" promptText="ejemplo@correo.com"
                           styleClass="custom-text-field"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Contraseña" styleClass="input-label"/>
                <PasswordField fx:id="registerPasswordField" promptText="••••••••"
                               styleClass="custom-text-field"
                               onKeyReleased="#checkPasswordStrength"/>
                <Label fx:id="passwordStrengthLabel" styleClass="info-label"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Confirmar contraseña" styleClass="input-label"/>
                <PasswordField fx:id="registerConfirmPasswordField" promptText="••••••••"
                               styleClass="custom-text-field"/>
            </VBox>

            <Label fx:id="registerErrorLabel" styleClass="error-label"
                   visible="false" managed="false"/>

            <Button text="Crear Cuenta" styleClass="button-primary"
                    onAction="#handleRegister" prefWidth="380.0" prefHeight="45.0">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>
            </Button>
        </VBox>
    </VBox>

</AnchorPane>
